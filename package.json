{
  "name": "greentic-messaging-providers",
  "private": true,
  "scripts": {
    "test:messaging-teams-setup": "playwright test -c tests/messaging-teams-setup/playwright.config.ts",
    "test:webchat-gui": "playwright test -c tests/webchat-gui/playwright.config.ts",
    "test:webchat-gui:headed": "playwright test -c tests/webchat-gui/playwright.config.ts --headed",
    "test:webchat-gui:update-snapshots": "WEBCHAT_GUI_VISUAL=1 playwright test -c tests/webchat-gui/playwright.config.ts --update-snapshots --project=chromium --grep @visual",
    "build:sso-bundle": "bash tools/build_webchat_sso_bundle.sh"
  },
  "dependencies": {
    "@greentic/sso": "git+https://git@github.com/greenticai/greentic-webchat-sdk.git#2696c1083f90886f82b65aab4573d1b7458925c0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.0"
  }
}
