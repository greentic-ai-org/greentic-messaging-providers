# Provider E2E credentials — "greentic-start send message" smoke tests.
#
# Scope: Teams, Slack, WebEx (the three providers wired for the send-message e2e).
# Usage:
#   cp e2e/.env.example .env      # .env is gitignored — never commit real values
#   set -a; source .env; set +a   # export into your shell, then run the e2e
#
# Each provider is independent: leave a block blank to SKIP that provider
# (the harness reports it as "skipped: missing required secrets" rather than
# failing). Fill a whole block to exercise that provider end-to-end.
#
# Var names match ci/provider-matrix.json (required_secrets) and the
# nightly-provider-e2e.yml workflow secrets, so the same .env works locally
# and mirrors CI.

# ──────────────────────────────────────────────────────────────────────────
# Slack  —  operation: chat.postMessage to a dedicated test channel
# ──────────────────────────────────────────────────────────────────────────
# Bot user OAuth token from a Slack app with chat:write scope (starts xoxb-).
E2E_SLACK_BOT_TOKEN=
# Channel ID (e.g. C0123456789) the bot has been invited to.
E2E_SLACK_CHANNEL_ID=
# Optional — only needed if the e2e also verifies inbound signature checks.
E2E_SLACK_SIGNING_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Microsoft Teams (Graph)  —  operation: Graph channel message send
# ──────────────────────────────────────────────────────────────────────────
# Entra (Azure AD) tenant ID (GUID) of the directory hosting the app + team.
E2E_TEAMS_TENANT_ID=
# Application (client) ID of the Entra app registration.
E2E_TEAMS_CLIENT_ID=
# Client secret VALUE (not the secret ID) for that app registration.
# NOTE: app-only (client-credentials) flow. The app needs Graph application
# permission ChannelMessage.Send with admin consent granted.
E2E_TEAMS_CLIENT_SECRET=
# Target team ID (the group/team GUID).
E2E_TEAMS_TEAM_ID=
# Target channel ID within that team (e.g. 19:xxxx@thread.tacv2).
E2E_TEAMS_CHANNEL_ID=

# ──────────────────────────────────────────────────────────────────────────
# Cisco WebEx  —  operation: messages API send to a dedicated room
# ──────────────────────────────────────────────────────────────────────────
# Bot access token from developer.webex.com (Bot, not personal token).
E2E_WEBEX_BOT_TOKEN=
# Room (space) ID the bot is a member of.
E2E_WEBEX_ROOM_ID=
