{
  "id": "messaging-provider-webchat",
  "name": "messaging-provider-webchat",
  "version": "0.4.100",
  "world": "greentic:component/component-v0-v6-v0@0.6.1",
  "description": "Provider-core WebChat messaging provider (send + ingest).",
  "profiles": {
    "default": "default",
    "supported": [
      "default"
    ]
  },
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/webchat/public.config.schema.json"
    }
  },
  "secret_requirements": [
    {
      "name": "jwt_signing_key",
      "aliases": [
        "JWT_SIGNING_KEY"
      ],
      "required": true,
      "scope": "tenant",
      "description": "Secret key used for Direct Line JWT token signing and verification.",
      "generated": {
        "policy": "random",
        "length": 20,
        "encoding": "raw_text",
        "scope": {
          "level": "tenant",
          "team": "_"
        },
        "regenerate_if_present": false
      }
    }
  ],
  "operations": [
    {
      "name": "qa-spec",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded QA specification",
        "additionalProperties": true,
        "properties": {
          "questions": {
            "type": "array",
            "description": "List of questions in the QA spec"
          }
        }
      }
    },
    {
      "name": "apply-answers",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "setup",
              "upgrade",
              "remove"
            ]
          },
          "answers_cbor": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "CBOR-encoded answers"
          }
        },
        "required": [
          "mode",
          "answers_cbor"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "CBOR-encoded result with config and optional cleanup plan",
        "additionalProperties": true,
        "properties": {
          "config": {
            "type": "object",
            "description": "Provider configuration"
          }
        }
      }
    }
  ],
  "capabilities": {
    "wasi": {},
    "host": {
      "state": {
        "read": true,
        "write": true
      }
    }
  }
}
