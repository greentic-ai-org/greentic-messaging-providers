package greentic:telegram-webhook@0.0.1;

use greentic:http/http-client@1.1.0 as http-client;
use greentic:secrets-store/secrets-store@1.0.0;

world telegram-webhook {
  import http-client;
  import secrets-store;

  type env-id = string;
  type tenant-id = string;
  type team-id = string;
  type user-id = string;
  type session-key = string;
  type json = string;

  record impersonation {
    actor-id: user-id,
    reason: option<string>,
  }

  record tenant-ctx {
    env: env-id,
    tenant: tenant-id,
    tenant-id: tenant-id,
    team: option<team-id>,
    team-id: option<team-id>,
    user: option<user-id>,
    user-id: option<user-id>,
    trace-id: option<string>,
    i18n-id: option<string>,
    correlation-id: option<string>,
    attributes: list<tuple<string, string>>,
    session-id: option<session-key>,
    flow-id: option<string>,
    node-id: option<string>,
    provider-id: option<string>,
    deadline-ms: option<s64>,
    attempt: u32,
    idempotency-key: option<string>,
    impersonation: option<impersonation>,
  }

  record exec-ctx {
    tenant: tenant-ctx,
    i18n-id: option<string>,
    flow-id: string,
    node-id: option<string>,
  }

  record node-error {
    code: string,
    message: string,
    retryable: bool,
    backoff-ms: option<u64>,
    details: option<json>,
  }

  variant invoke-result {
    ok(json),
    err(node-error),
  }

  variant stream-event {
    data(json),
    progress(u8),
    done,
    error(string),
  }

  enum lifecycle-status {
    ok,
  }

  export get-manifest: func() -> json;
  export on-start: func(ctx: exec-ctx) -> result<lifecycle-status, string>;
  export on-stop: func(ctx: exec-ctx, reason: string) -> result<lifecycle-status, string>;
  export invoke: func(ctx: exec-ctx, op: string, input: json) -> invoke-result;
  export invoke-stream: func(ctx: exec-ctx, op: string, input: json) -> list<stream-event>;
}
