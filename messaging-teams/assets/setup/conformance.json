    "bot_framework_registration_before_publish",
    "teams_app_publish",
    "teams_app_install",
    "open_bot_chat",
    "first_activity_received",
    "send_test_card",
    "adaptive_card_action_received"
  ],
  "runtime_cases": [
    "bot_framework_activity_ingestion",
    "bot_framework_authentication_failure",
    "bot_framework_message_normalization",
    "adaptive_card_submit_normalization",
    "adaptive_card_follow_up_response",
    "conversation_context_available"
  ],
  "setup_component_contract": {
    "schema_id": "greentic.setup.web-component.v1",
    "module_asset": "assets/setup/greentic-teams-setup.js",
    "tag_name": "greentic-teams-setup-v4",
    "generic_events": [
      "greentic-provider-setup-state",
      "greentic-provider-setup-result",
      "greentic-provider-setup-action-start",
