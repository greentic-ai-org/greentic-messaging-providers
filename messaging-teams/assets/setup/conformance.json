    "provider_specific_setup_server_required": false
  },
  "tester_contract": {
    "one_button_step_execution": true,
    "raw_controls_are_diagnostics": true,
    "node_botbuilder_sidecar_default": false,
    "node_botbuilder_sidecar_opt_in": true,
    "azure_bot_service_required": true
  }
