{
  "tenant": "3aigent",
  "mode": "fullpage",
  "brand": {
    "name": "3AIgent",
    "favicon": "./assets/favicon.ico",
    "logo": "./assets/3point-jewel-round.png",
    "primary": "#06b6d4"
  },
  "directLine": {},
  "webchat": {
    "styleOptions": "./webchat/styleOptions.json",
    "styleOptionsThemed": true,
    "adaptiveCardsHostConfig": "./webchat/hostconfig.json",
