  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/teams/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.3",
      "inline": {
        "offers": [
          {
            "cap_id": "greentic.cap.messaging.provider.v1",
            "offer_id": "messaging-teams-v1",
            "priority": 100,
            "provider": {
              "component_ref": "messaging-provider-teams",
              "op": "messaging.configure"
            },
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-teams"
            },
            "version": "0.5.3"
          }
        ],
        "schema_version": 1
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.3",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.3",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.teams.graph",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/teams/public.config.schema.json",
            "runtime": {
              "component_ref": "messaging-provider-teams",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.microsoft_app_catalog.v1": {
      "kind": "messaging.microsoft_app_catalog.v1",
      "version": "0.5.3",
      "inline": {
        "icons": {
          "color": "color.png",
          "outline": "outline.png"
        },
        "install_scopes": [
          "team",
          "personal"
        ],
        "manifest_template": "assets/teams-app/manifest.template.json",
        "supports_requires_review": true
      }
    },
    "messaging.oauth.v1": {
      "kind": "messaging.oauth.v1",
      "version": "0.5.3",
      "inline": {
        "auth_type": "oauth2_device_code",
        "device_code_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/devicecode",
        "provider_id": "teams",
        "scopes": [
          "offline_access",
          "openid",
          "profile",
          "User.Read",
          "Team.ReadBasic.All",
          "Channel.ReadBasic.All",
          "Channel.Create",
          "ChannelMessage.Send",
          "ChannelMessage.Read.All",
          "Chat.Read"
        ],
        "secret_keys": [
          "MS_GRAPH_TENANT_ID",
          "MS_GRAPH_CLIENT_ID",
          "MS_GRAPH_REFRESH_TOKEN",
          "MS_GRAPH_ACCESS_TOKEN"
        ],
        "tenant_alias": "organizations",
        "token_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/token",
        "verification_uri": "https://microsoft.com/devicelogin"
      }
    },
    "messaging.oauth_device_code.v1": {
      "kind": "messaging.oauth_device_code.v1",
      "version": "0.5.3",
      "inline": {
        "checklist": [
          "App registration must be multi-tenant: signInAudience = AzureADMultipleOrgs",
          "Public client/device code flow must be enabled",
          "Tenant may require admin consent",
          "Teams message subscriptions require delegated read scopes such as ChannelMessage.Read.All",
          "Creating a missing Teams channel requires delegated Channel.Create and a signed-in user allowed to create channels in the selected Team",
          "Device/token endpoints must use organizations, not the developer tenant ID"
        ],
        "client_id_config_key": "client_id",
        "client_id_secret_key": "MS_GRAPH_CLIENT_ID",
        "config_out": {
          "channel_id": "channel_id",
          "channel_name": "channel_name",
          "chat_id": "chat_id",
          "client_id": "client_id",
          "desired_channel_name": "desired_channel_name",
          "team_id": "team_id",
          "team_name": "team_name",
          "tenant_id": "tenant_id",
          "user_id": "user_id"
        },
        "device_code_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/devicecode",
        "label": "Connect Microsoft Teams",
        "post_login_discovery": [
          {
            "id": "me",
            "method": "GET",
            "save": {
              "id": "user_id",
              "tenant_id": "tenant_id"
            },
            "url": "https://graph.microsoft.com/v1.0/me"
          },
          {
            "id": "joined_teams",
            "method": "GET",
            "select": {
              "from": "value",
              "label": "displayName",
              "save_label_as": "team_name",
              "save_as": "team_id",
              "value": "id"
            },
            "url": "https://graph.microsoft.com/v1.0/me/joinedTeams"
          },
          {
            "id": "channels",
            "method": "GET",
            "requires": [
              "team_id"
            ],
            "select": {
              "from": "value",
              "label": "displayName",
              "save_label_as": "channel_name",
              "save_as": "channel_id",
              "value": "id"
            },
            "url_template": "https://graph.microsoft.com/v1.0/teams/{team_id}/channels"
          }
        ],
        "provider": "microsoft",
        "provider_id": "teams",
        "scopes": [
          "offline_access",
          "openid",
          "profile",
          "User.Read",
          "Team.ReadBasic.All",
          "Channel.ReadBasic.All",
          "Channel.Create",
          "ChannelMessage.Send",
          "ChannelMessage.Read.All",
          "Chat.Read"
        ],
        "secrets_out": {
          "access_token": "MS_GRAPH_ACCESS_TOKEN",
          "client_id": "MS_GRAPH_CLIENT_ID",
          "refresh_token": "MS_GRAPH_REFRESH_TOKEN"
        },
        "tenant_alias": "organizations",
        "token_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/token",
        "verification_uri": "https://microsoft.com/devicelogin",
        "setup_modes": {
          "graph_channel": {
            "description": "Default mode. Uses Microsoft Graph delegated tokens plus team_id/channel_id for outbound channel messages.",
            "config_keys": [
              "tenant_id",
              "client_id",
              "team_id",
              "team_name",
              "channel_id",
              "channel_name",
              "desired_channel_name"
            ],
            "provisioning": {
              "teams_channel": {
                "component_ref": "messaging-provider-teams",
                "graph": {
                  "body_template": {
                    "displayName": "{desired_channel_name}",
                    "membershipType": "standard"
                  },
                  "method": "POST",
                  "required_scopes": {
                    "delegated": [
                      "Channel.Create"
                    ]
                  },
                  "resource_template": "/teams/{team_id}/channels"
                },
                "mode": "create_if_missing",
                "op": "apply-answers",
                "output_keys": {
                  "channel_id": "channel_id",
                  "channel_name": "channel_name"
                },
                "source_keys": {
                  "desired_channel_name": "desired_channel_name",
                  "team_id": "team_id"
                }
              }
            }
          },
          "bot_framework": {
            "description": "Inbound Bot Framework mode. Uses Azure Bot credentials and a Teams app manifest messaging endpoint.",
            "config_keys": [
              "ms_bot_app_id",
              "ms_bot_app_password",
              "bot_display_name",
              "messaging_endpoint"
            ]
          }
        }
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.5.3",
      "inline": {
        "capabilities": {
          "content_types": [
            "application/json"
          ],
          "supports_webhook_validation": true
        },
        "component_ref": "messaging-ingress-teams",
        "export": "handle-webhook",
        "world": "greentic:messaging-ingress-teams/messaging-ingress-teams@0.0.1"
      }
    },
    "messaging.subscriptions.v1": {
      "kind": "messaging.subscriptions.v1",
      "version": "0.5.3",
      "inline": {
        "component_ref": "messaging-ingress-teams",
        "export": "sync-subscriptions",
        "pattern": "sync",
        "renewal_window_hours": 24,
        "resources": [
          "message"
        ],
        "desired_state": {
          "source": "setup_answers",
          "output_key": "desired_subscriptions",
          "source_keys": [
            "team_id",
            "channel_id",
            "chat_id"
          ],
          "defaults": {
            "change_type": "created"
          },
          "notification_url": {
            "template": "{public_base_url}/v1/messaging/ingress/{provider_id}/{tenant}/{team}",
            "state_key": "notification_url"
          },
          "expiration_policy": {
            "state_key": "expiration_datetime",
            "required": true,
            "host_supplied": true,
            "description": "Microsoft Graph subscriptions require an expirationDateTime on create and renewal."
          },
          "templates": [
            {
              "id": "teams_channel_messages",
              "when_all": [
                "team_id",
                "channel_id"
              ],
              "resource_template": "/teams/{team_id}/channels/{channel_id}/messages",
              "change_type": "created",
              "expiration_datetime": "{expiration_datetime}",
              "notification_url": "{notification_url}"
            },
            {
              "id": "teams_chat_messages",
              "when_all": [
                "chat_id"
              ],
              "resource_template": "/chats/{chat_id}/messages",
              "change_type": "created",
              "expiration_datetime": "{expiration_datetime}",
              "notification_url": "{notification_url}"
            }
          ]
        },
        "world": "greentic:messaging-ingress-teams/messaging-ingress-teams@0.0.1"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-ingress-teams",
        "kind": "ingress",
        "name": "messaging.teams.ingress"
      },
      {
        "component": "messaging-provider-teams",
        "kind": "egress",
        "name": "messaging.teams.graph"
      }
    ]
  },
  "secret_requirements": [],
  "capabilities_cache": [
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "ai.greentic.component-templates",
      "version": "v1",
      "path": "components/ai.greentic.component-templates-capabilities_v1.json"
    },
    {
      "component": "templates",
      "version": "v1",
      "path": "components/templates-capabilities_v1.json"
    }
  ]
}
