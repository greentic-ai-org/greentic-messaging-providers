{
  "schema_id": "greentic-messaging-provider.build-answer",
  "schema_version": "1.0.0",
  "provider": {
    "id": "messaging-email",
    "display_name": "Email",
    "version": "0.5.1",
    "kind": "application",
    "publisher": "Greentic",
    "description": "Legacy SMTP email messaging provider"
  },
  "components": [
    {
      "id": "messaging-provider-email",
      "source": "components/messaging-provider-email",
      "version": "0.5.1",
      "world": "greentic:component/component-v0-v6-v0@0.6.1",
      "supports": ["messaging"],
      "profiles": {
        "default": "default",
        "supported": ["default"]
      },
      "capabilities": {
        "wasi": {
          "random": false,
          "clocks": false
        },
        "host": {
          "secrets-store": true,
          "http-client": true
        }
      },
      "wasm": "components/messaging-provider-email/component.wasm",
      "manifest": "components/messaging-provider-email/component.manifest.json"
    }
  ],
  "assets": [
    "secret-requirements.json",
    "schemas/messaging/email/public.config.schema.json",
    "fixtures/egress.request.json",
    "fixtures/egress.expected.summary.json"
  ],
  "setup": {
    "asset": "assets/setup.yaml",
    "provider_id": "email",
    "fields": [
      {
        "name": "from_address",
        "required": true,
        "secret": false,
        "config_key": "from_address"
      },
      {
        "name": "public_base_url",
        "required": false,
        "secret": false,
        "config_key": "public_base_url"
      },
      {
        "name": "host",
        "required": true,
        "secret": false,
        "config_key": "host"
      },
      {
        "name": "port",
        "required": true,
        "secret": false,
        "config_key": "port"
      },
      {
        "name": "username",
        "required": true,
        "secret": false,
        "config_key": "username"
      },
      {
        "name": "password",
        "required": true,
        "secret": true,
        "secret_key": "EMAIL_PASSWORD"
      },
      {
        "name": "tls_mode",
        "required": true,
        "secret": false,
        "config_key": "tls_mode"
      }
    ]
  },
  "extensions": {
    "capabilities": {
      "offer_id": "messaging-email-v1",
      "cap_id": "greentic.cap.messaging.provider.v1",
      "component_ref": "messaging-provider-email",
      "op": "messaging.configure",
      "priority": 100,
      "requires_setup": true,
      "qa_ref": "components/messaging-provider-email"
    },
    "validators": [
      {
        "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
        "id": "greentic.validators.messaging",
        "world": "greentic:pack-validate/pack-validator@0.1.0"
      }
    ],
    "provider": {
      "provider_type": "messaging.email.smtp",
      "capabilities": ["messaging"],
      "ops": ["send", "reply", "qa-spec", "apply-answers", "i18n-keys"],
      "config_schema_ref": "schemas/messaging/email/public.config.schema.json",
      "runtime": {
        "component_ref": "messaging-provider-email",
        "export": "schema-core-api",
        "world": "greentic:provider/schema-core@1.0.0"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-provider-email",
        "kind": "egress",
        "name": "messaging.email.smtp"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "EMAIL_PASSWORD",
      "scope": "tenant",
      "description": "SMTP password secret key"
    }
  ],
  "outputs": {
    "pack_yaml": "pack.yaml",
    "manifest": "pack.manifest.json",
    "gtpack": "dist/messaging-email.gtpack"
  }
}
