{
  "name": "messaging-telegram",
  "version": "0.4.39",
  "kind": "application",
  "publisher": "Greentic",
  "description": "Telegram messaging provider — bot API with webhook ingress",
  "component_sources": [
    {
      "id": "messaging-provider-telegram",
      "version": "0.4.39",
      "world": "greentic:component/component-v0-v6-v0@0.6.1",
      "supports": ["messaging"],
      "profiles": {
        "default": "default",
        "supported": ["default"]
      },
      "capabilities": {
        "wasi": {
          "random": false,
          "clocks": false
        },
        "host": {
          "secrets-store": true,
          "http-client": true
        }
      },
      "wasm": "components/messaging-provider-telegram/component.wasm",
      "manifest": "components/messaging-provider-telegram/component.manifest.json"
    },
    {
      "id": "messaging-ingress-telegram",
      "version": "0.4.39",
      "world": "greentic:messaging-ingress-telegram/messaging-ingress-telegram@0.0.1",
      "supports": ["messaging"],
      "profiles": {
        "default": "default",
        "supported": ["default"]
      },
      "capabilities": {
        "wasi": {
          "random": false,
          "clocks": false
        },
        "host": {
          "secrets-store": true,
          "state-store": true,
          "http-client": true
        }
      },
      "wasm": "components/messaging-ingress-telegram/component.wasm",
      "manifest": "components/messaging-ingress-telegram/component.manifest.json"
    }
  ],
  "components": ["messaging-provider-telegram", "messaging-ingress-telegram"],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/telegram/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.4.39",
      "inline": {
        "schema_version": 1,
        "offers": [
          {
            "offer_id": "messaging-telegram-v1",
            "cap_id": "greentic.cap.messaging.provider.v1",
            "version": "0.4.39",
            "provider": {
              "component_ref": "messaging-provider-telegram",
              "op": "messaging.configure"
            },
            "priority": 100,
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-telegram"
            }
          }
        ]
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.4.39",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.4.39",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.telegram.bot",
            "capabilities": ["messaging"],
            "ops": ["send", "reply", "qa-spec", "apply-answers", "i18n-keys"],
            "config_schema_ref": "schemas/messaging/telegram/public.config.schema.json",
            "runtime": {
              "component_ref": "messaging-provider-telegram",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    },
    "messaging.provider_ingress.v1": {
      "kind": "messaging.provider_ingress.v1",
      "version": "0.4.39",
      "inline": {
        "capabilities": {
          "content_types": ["application/json"],
          "supports_webhook_validation": true
        },
        "component_ref": "messaging-ingress-telegram",
        "export": "handle-webhook",
        "world": "greentic:messaging-ingress-telegram/messaging-ingress-telegram@0.0.1"
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-ingress-telegram",
        "kind": "ingress",
        "name": "messaging.telegram.ingress"
      },
      {
        "component": "messaging-provider-telegram",
        "kind": "egress",
        "name": "messaging.telegram.bot"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "scope": "tenant",
      "description": "Telegram bot token used for sendMessage requests."
    }
  ]
}
