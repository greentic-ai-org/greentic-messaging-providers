{
  "name": "messaging-microsoft-email",
  "version": "0.5.2",
  "kind": "application",
  "publisher": "Greentic",
  "description": "Microsoft Graph email messaging provider",
  "component_sources": [
    {
      "id": "messaging-provider-email",
      "version": "0.5.2",
      "world": "greentic:component/component-v0-v6-v0@0.6.1",
      "supports": [
        "messaging"
      ],
      "profiles": {
        "default": "default",
        "supported": [
          "default"
        ]
      },
      "capabilities": {
        "wasi": {
          "random": false,
          "clocks": false
        },
        "host": {
          "secrets-store": true,
          "http-client": true
        }
      },
      "wasm": "components/messaging-provider-email/component.wasm",
      "manifest": "components/messaging-provider-email/component.manifest.json"
    }
  ],
  "components": [
    "messaging-provider-email"
  ],
  "config_schema": {
    "provider_config": {
      "format": "json",
      "path": "schemas/messaging/email/public.config.schema.json"
    }
  },
  "extensions": {
    "greentic.ext.capabilities.v1": {
      "kind": "greentic.ext.capabilities.v1",
      "version": "0.5.2",
      "inline": {
        "schema_version": 1,
        "offers": [
          {
            "offer_id": "messaging-microsoft-email-v1",
            "cap_id": "greentic.cap.messaging.provider.v1",
            "version": "0.5.2",
            "provider": {
              "component_ref": "messaging-provider-email",
              "op": "messaging.configure"
            },
            "priority": 100,
            "requires_setup": true,
            "setup": {
              "qa_ref": "components/messaging-provider-email"
            }
          }
        ]
      }
    },
    "greentic.messaging.validators.v1": {
      "kind": "greentic.messaging.validators.v1",
      "version": "0.5.2",
      "inline": {
        "validators": [
          {
            "component_ref": "oci://ghcr.io/greenticai/validators/messaging:0.4.19",
            "id": "greentic.validators.messaging",
            "world": "greentic:pack-validate/pack-validator@0.1.0"
          }
        ]
      }
    },
    "greentic.provider-extension.v1": {
      "kind": "greentic.provider-extension.v1",
      "version": "0.5.2",
      "inline": {
        "providers": [
          {
            "provider_type": "messaging.email.microsoft_graph",
            "capabilities": [
              "messaging"
            ],
            "ops": [
              "send",
              "reply",
              "ingest_http",
              "render_plan",
              "encode",
              "send_payload",
              "subscription_ensure",
              "subscription_renew",
              "subscription_delete",
              "qa-spec",
              "apply-answers",
              "i18n-keys"
            ],
            "config_schema_ref": "schemas/messaging/email/public.config.schema.json",
            "runtime": {
              "component_ref": "messaging-provider-email",
              "export": "schema-core-api",
              "world": "greentic:provider/schema-core@1.0.0"
            }
          }
        ]
      }
    }
  },
  "messaging": {
    "adapters": [
      {
        "component": "messaging-provider-email",
        "kind": "egress",
        "name": "messaging.email.microsoft_graph"
      }
    ]
  },
  "secret_requirements": [
    {
      "name": "FROM_ADDRESS",
      "scope": "tenant",
      "description": "Microsoft Graph sender mailbox"
    },
    {
      "name": "GRAPH_TENANT_ID",
      "scope": "tenant",
      "description": "Microsoft Entra tenant ID"
    },
    {
      "name": "MS_GRAPH_CLIENT_ID",
      "scope": "tenant",
      "description": "Microsoft Graph OAuth client ID"
    },
    {
      "name": "MS_GRAPH_REFRESH_TOKEN",
      "scope": "tenant",
      "description": "Microsoft Graph OAuth refresh token"
    },
    {
      "name": "MS_GRAPH_CLIENT_SECRET",
      "scope": "tenant",
      "description": "Microsoft Graph OAuth client secret"
    }
  ]
}
