{
  "provider": "messaging.teams.graph",
  "config_required": [
    "enabled",
    "tenant_id",
    "client_id"
  ],
  "config_optional": [
    "public_base_url",
    "team_id",
    "channel_id",
    "chat_id",
    "graph_base_url",
    "auth_base_url",
    "token_scope"
  ],
  "secret_required": [
    "MS_GRAPH_REFRESH_TOKEN"
  ],
  "secret_optional": [
    "MS_GRAPH_ACCESS_TOKEN"
  ],
  "oauth_required": true,
  "subscriptions_required": false
}
